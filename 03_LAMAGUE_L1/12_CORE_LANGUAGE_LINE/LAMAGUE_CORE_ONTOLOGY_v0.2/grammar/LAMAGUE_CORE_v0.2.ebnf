(* LAMAGUE Core v0.2 — Primitive Ontology and Type Lock *)

program               = { statement } ;

statement             = let_statement
                      | invariant_statement
                      | require_statement
                      | forbid_statement
                      | macro_statement
                      | check_statement
                      | describe_statement
                      | expression_statement ;

let_statement         = "let" identifier [ type_annotation ] "=" expression ";" ;
invariant_statement   = "invariant" identifier [ type_annotation ] "=" expression ";" ;
require_statement     = "require" expression ";" ;
forbid_statement      = "forbid" expression ";" ;
macro_statement       = "macro" meta identifier [ type_annotation ] "=" expression ";" ;

check_statement       = "check" (
                          "equivalent" "(" expression "," expression ")"
                        | "type" "(" expression "," type_name ")"
                        | "subtype" "(" type_name "," type_name ")"
                        ) ";" ;

describe_statement    = "describe" expression ";" ;
expression_statement  = expression ";" ;
type_annotation       = ":" type_name ;

expression            = path_expression ;
path_expression       = dynamic_expression { ("→" | "⇌") dynamic_expression } ;
dynamic_expression    = fusion_expression { ("↯" | "↗" | "⟲") fusion_expression } ;
fusion_expression     = primary { "⊗" primary } ;
primary               = atom | identifier | "(" expression ")" ;

primitive_field       = "Ao" | "Φ" | "Ψ" | "S" | "Δ" ;
derived_field         = "Φ↑" ;
invariant_marker      = "⟟" | "⟐" | "⟁" | "∞" ;
null_state            = "∅" ;
invariant_field       = "Ψ_inv" ;

atom                  = primitive_field
                      | derived_field
                      | invariant_marker
                      | null_state
                      | invariant_field ;

meta                  = "Z₁" | "Z₂" | "Z₃" ;

type_name             = "StateLike"
                      | "Field"
                      | "ModifiedField"
                      | "Invariant"
                      | "InvariantMarker"
                      | "InvariantField"
                      | "NullState"
                      | "Composite"
                      | "Fusion"
                      | "Path"
                      | "Exchange"
                      | "Recurrence"
                      | "Collapse"
                      | "Ascent" ;

identifier            = letter { letter | digit | "_" } ;

(* Internal decomposition lock:
   Φ↑    = modify(Φ, ↑)
   Ψ_inv = qualify(Ψ, inv)
*)

(* Warning-bearing aliases:
   A₀→Ao, ∆→Δ, ♾→∞, ->→→, <->→⇌
*)

(* ∅ is intentional null. It is never unknown, missing, false, or error. *)
