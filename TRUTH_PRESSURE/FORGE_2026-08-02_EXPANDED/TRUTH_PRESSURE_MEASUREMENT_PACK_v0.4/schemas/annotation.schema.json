{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Truth Pressure Human Annotation v0.4",
  "type": "object",
  "required": [
    "item_code", "E_score_0_4", "E_confidence_1_3",
    "P_score_0_4", "P_confidence_1_3",
    "S_score_0_4", "S_confidence_1_3",
    "brief_reason", "ambiguity_flag_yes_no"
  ],
  "properties": {
