{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lycheetah/Lycheetah-Framework/lycheetah/assurance/schemas/policy.schema.json",
  "title": "Lycheetah Assurance Policy v0.1",
  "type": "object",
  "required": ["id", "version"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manipulation_review_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "aura_review_below_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "max_text_characters": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/textRule"}
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_approval_for_side_effects": {"type": "boolean"},
        "denied": {"$ref": "#/$defs/stringArray"},
        "review": {"$ref": "#/$defs/stringArray"},
        "allowlist": {"$ref": "#/$defs/stringArray"},
        "blocked_scopes": {"$ref": "#/$defs/stringArray"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capture_content": {"type": "boolean"},
        "capture_arguments": {"type": "boolean"},
        "capture_evidence_spans": {"type": "boolean"},
        "sensitive_argument_keys": {"$ref": "#/$defs/stringArray"}
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "textRule": {
      "type": "object",
      "required": ["id", "pattern"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
        "pattern": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "phases": {
          "type": "array",
          "items": {"enum": ["input", "output"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "requested_disposition": {"enum": ["ALLOW", "REVIEW", "BLOCK"]},
        "claim_status": {"enum": ["ACTIVE", "SCAFFOLD", "CONJECTURE"]},
        "deterministic": {"type": "boolean"},
        "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "status_basis": {"type": "string"},
        "ignore_case": {"type": "boolean"}
      }
    }
  }
}
