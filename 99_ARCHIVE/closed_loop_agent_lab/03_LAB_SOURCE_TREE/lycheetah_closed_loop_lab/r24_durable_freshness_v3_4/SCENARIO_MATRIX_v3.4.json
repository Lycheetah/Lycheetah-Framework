      "verified": true
    },
    {
      "id": "V34-04",
      "case": "verifier restarts with same ledger and key",
      "expected": "CONSUMED_STATE_PERSISTS",
      "verified": true
    },
    {
      "id": "V34-05",
      "case": "unissued nonce",
      "expected": "REJECT",
      "verified": true
    },
    {
      "id": "V34-06",
      "case": "expiry before verification",
      "expected": "REJECT",
      "verified": true
    },
    {
      "id": "V34-07",
