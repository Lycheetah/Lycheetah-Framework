{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lycheetah.com/anon-politician/schemas/decision-response-ledger-v0.3.json",
  "title": "Public Decision-Response Ledger Entry v0.3",
  "type": "object",
  "required": ["theme_id", "theme_summary", "input_channels", "decision_status", "decision_rationale", "decision_owner", "response_date", "reopen_trigger"],
  "properties": {
    "theme_id": {"type": "string", "minLength": 1},
    "theme_summary": {"type": "string", "minLength": 1},
    "input_channels": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "minority_or_high_severity_concern": {"type": "boolean"},
    "decision_status": {"enum": ["accepted", "partially_accepted", "not_adopted", "deferred", "outside_authority", "needs_more_evidence", "unresolved"]},
    "decision_rationale": {"type": "string"},
    "policy_change": {"type": "string"},
    "change_basis": {"type": "array", "items": {"enum": ["public_input", "evidence", "legal_requirement", "implementation_learning", "value_judgment", "other"]}},
    "decision_owner": {"type": "string", "minLength": 1},
    "response_date": {"type": "string"},
    "follow_up_owner": {"type": "string"},
    "follow_up_due": {"type": "string"},
    "reopen_trigger": {"type": "string", "minLength": 1},
    "audit_history": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
