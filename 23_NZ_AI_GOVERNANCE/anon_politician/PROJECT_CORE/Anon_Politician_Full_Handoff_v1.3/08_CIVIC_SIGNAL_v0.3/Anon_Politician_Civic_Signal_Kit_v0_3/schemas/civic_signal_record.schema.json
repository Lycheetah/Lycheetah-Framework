{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lycheetah.com/anon-politician/schemas/civic-signal-record-v0.3.json",
  "title": "Anon Politician Civic Signal Record v0.3",
  "description": "Metadata and declared inference claims for a civic participation process. Schema validation does not certify representativeness or execution quality.",
  "type": "object",
  "required": ["study_id", "topic", "recruitment", "claims", "survey_design", "governance", "decision_context"],
  "properties": {
    "study_id": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "te_tiriti_or_maori_relevance": {"type": "boolean"},
    "recruitment": {
      "type": "object",
      "required": ["method", "target_population", "sample_size"],
      "properties": {
        "method": {"enum": ["open_opt_in", "probability_sample", "deliberative_panel", "targeted_consultation", "stakeholder_submissions"]},
        "target_population": {"type": "string"},
        "sampling_frame": {"type": ["string", "null"]},
        "probability_selection": {"type": "boolean"},
        "selection_and_stratification": {"type": ["string", "null"]},
        "sample_size": {"type": "integer", "minimum": 0},
        "response_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "nonresponse_assessment": {"type": ["string", "null"]},
        "weighting_method": {"type": ["string", "null"]},
        "weighting_plan": {"type": ["string", "null"]},
        "uncertainty_method": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "claims": {"type": "array", "items": {"type": "string"}},
    "survey_design": {
      "type": "object",
      "properties": {
        "question_wording_published": {"type": "boolean"},
        "undecided_option": {"type": "boolean"},
        "evidence_brief_provided": {"type": "boolean"},
        "evidence_sources_published": {"type": "boolean"},
        "initial_response_collected": {"type": "boolean"},
        "post_information_response_collected": {"type": "boolean"},
        "evidence_pack_version": {"type": ["string", "null"]},
        "participant_questions_allowed": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "governance": {
      "type": "object",
      "properties": {
        "personal_data_collected": {"type": "boolean"},
        "privacy_notice_published": {"type": "boolean"},
        "retention_policy_published": {"type": "boolean"},
        "consent_or_lawful_basis_reviewed": {"type": "boolean"},
        "security_review_complete": {"type": "boolean"},
        "accessibility_plan": {"type": "boolean"},
        "maori_engagement_plan": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "decision_context": {
      "type": "object",
      "properties": {
        "decision_owner": {"type": "string"},
        "open_to_change": {"type": "string"},
        "response_commitment": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
